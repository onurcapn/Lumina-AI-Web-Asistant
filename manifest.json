{
  "manifest_version": 3,
  "name": "Lumina AI Summarizer",
  "version": "1.0",
  "description": "Premium AI assistant to summarize web pages and selected text.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "action": {},
  "options_page": "options.html"
}
