{
  "manifest_version": 3,
  "name": "Lumina AI Web Assistant",
  "version": "1.2",
  "description": "Premium AI Web Assistant: Gemini, GPT, Groq & Claude ile anında özetleme, analiz ve akıllı not alma.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Lumina AI Panelini Aç",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
